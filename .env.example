# MongoDB (connectors / connection_logs / query_log)
MONGO_URI=mongodb://USER:PASSWORD@localhost:27017/datahive?authSource=datahive
MONGO_COLLECTION=connectors
# MONGO_QUERY_LOGS_COLLECTION=query_log

# PostgreSQL (Assets tab — silver / gold schemas in datahive database)
# Must match the login you use in pgAdmin / psql.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=datahive
POSTGRES_ASSET_SCHEMAS=bronze,silver,gold

# Or one connection string (special characters in password must be URL-encoded):
# POSTGRES_CONNINFO=postgresql://postgres:your_password_here@localhost:5432/datahive
